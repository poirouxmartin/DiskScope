<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF drops System.IO from implicit usings (Path clashes with System.Windows.Shapes.Path); tests need it back. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiskScope.Core\DiskScope.Core.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Monitoring\DiskScope.Monitoring.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Monitoring.CpuRam\DiskScope.Monitoring.CpuRam.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Processes\DiskScope.Processes.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Monitoring.Gpu\DiskScope.Monitoring.Gpu.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.History\DiskScope.History.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Diagnostics\DiskScope.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Maintenance\DiskScope.Maintenance.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Reports\DiskScope.Reports.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Storage\DiskScope.Storage.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Scanner\DiskScope.Scanner.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Scanner.Standard\DiskScope.Scanner.Standard.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Scanner.Ntfs\DiskScope.Scanner.Ntfs.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.App\DiskScope.App.csproj" />
    <ProjectReference Include="..\..\src\DiskScope.Benchmarks\DiskScope.Benchmarks.csproj" />
  </ItemGroup>

</Project>
