<Application x:Class="DiskScope.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiskScope.App.Controls"
             xmlns:vm="clr-namespace:DiskScope.App.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5DAE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,10,6,2" />
        </Style>

        <!-- One metric: current value, short trend, recent maximum. "n/a" when unknown; the tooltip gives the definition and source. -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:MetricTileViewModel}">
            <StackPanel ToolTip="{Binding ToolTip}" MinWidth="220">
                <TextBlock Text="{Binding Title}" Foreground="#4A5560" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ValueText}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Foreground="#4A5560" />
                <controls:SparklineControl Height="44" Margin="0,4,0,2"
                                           Points="{Binding Points}" End="{Binding End}"
                                           Window="{Binding Window}" Maximum="{Binding Maximum}" />
                <TextBlock Text="{Binding PeakText}" Foreground="#6B7580" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>
