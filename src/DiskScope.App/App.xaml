<Application x:Class="DiskScope.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiskScope.App.Controls"
             xmlns:vm="clr-namespace:DiskScope.App.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="6" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="6,10,6,2" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Button with an icon (glyph in Tag) and a label. Secondary look by default. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" Text="{TemplateBinding Tag}" FontSize="14" Margin="0,0,8,0" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The one main action of a screen. -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Opens its ContextMenu under itself on click (App.xaml.cs): one "Export" button per screen. -->
            <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Tag" Value="{StaticResource GlyphExport}" />
                <EventSetter Event="Click" Handler="OnMenuButtonClick" />
            </Style>

            <!-- Left navigation rail: TabControl with the tabs stacked vertically, glyph in each TabItem's Tag. -->
            <Style x:Key="RailTabControl" TargetType="TabControl">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource ChromeBrush}" Padding="6">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                                <Border Background="{DynamicResource WindowBrush}">
                                    <ContentPresenter ContentSource="SelectedContent" Margin="8,6,6,0" />
                                </Border>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RailItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Margin="0,1">
                                <Border x:Name="Bd" CornerRadius="{DynamicResource ControlRadius}" Background="Transparent" Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{TemplateBinding Tag}" FontSize="16" Width="20" Margin="0,0,12,0" />
                                        <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}" Visibility="Hidden" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One metric: current value, short trend, recent maximum. "n/a" when unknown; the tooltip gives the definition and source. -->
            <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:MetricTileViewModel}">
                <StackPanel ToolTip="{Binding ToolTip}" MinWidth="220">
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ValueText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" />
                    <controls:SparklineControl Height="44" Margin="0,4,0,2"
                                               Points="{Binding Points}" End="{Binding End}"
                                               Window="{Binding Window}" Maximum="{Binding Maximum}" />
                    <TextBlock Text="{Binding PeakText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
