<UserControl x:Class="DiskScope.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A clickable card: opens the module given by the tile's NavigateTo. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5DAE0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Width" Value="260" />
            <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding NavigateTo}" />
            <Setter Property="ContentTemplate" Value="{StaticResource TileTemplate}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F0F2F5">
        <StackPanel Margin="6">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Now" />
            <WrapPanel>
                <Button Style="{StaticResource CardButton}" DataContext="{Binding Monitoring.CpuTile}" Content="{Binding}" />
                <Button Style="{StaticResource CardButton}" DataContext="{Binding Monitoring.MemoryTile}" Content="{Binding}" />
                <Button Style="{StaticResource CardButton}" DataContext="{Binding Monitoring.CommitTile}" Content="{Binding}" />
                <ItemsControl ItemsSource="{Binding Monitoring.GpuTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Content="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Volumes" />
            <ItemsControl ItemsSource="{Binding Monitoring.VolumeTiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Findings" />
            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="260">
                    <StackPanel>
                        <TextBlock Text="Active alerts (not acknowledged)" Foreground="#4A5560" />
                        <TextBlock Text="{Binding Monitoring.ActiveAlertCount}" FontSize="22" FontWeight="SemiBold" />
                        <Button Content="Open history &amp; alerts" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="8,2"
                                Command="{Binding NavigateCommand}" CommandParameter="5" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260">
                    <StackPanel>
                        <TextBlock Text="Memory growth suspicions" Foreground="#4A5560" />
                        <TextBlock Text="{Binding Processes.SuspicionCount}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Sustained growth over 10 min, to verify" Foreground="#6B7580" FontSize="11" />
                        <Button Content="Open processes" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="8,2"
                                Command="{Binding NavigateCommand}" CommandParameter="3" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" DataContext="{Binding Monitoring.SelfCpuTile}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TileTemplate}" />
                </Border>
            </WrapPanel>
            <TextBlock Margin="8,4" Foreground="#6B7580" TextWrapping="Wrap"
                       Text="Network and hardware sensors are not monitored yet. Values read n/a when the source does not provide them; they are never shown as 0." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
