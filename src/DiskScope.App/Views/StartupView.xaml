<UserControl x:Class="DiskScope.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2" />
            <Button Content="Export start-up CSV" Command="{Binding ExportStartupCommand}" Padding="10,2" Margin="6,0,0,0" />
            <Button Content="Export services CSV" Command="{Binding ExportServicesCommand}" Padding="10,2" Margin="6,0,0,0" />
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalContentAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#4A5560" Margin="0,0,0,4" />
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Errors}" Foreground="#B00020" MaxHeight="80" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding Startup}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100" />
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="100" />
                    <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled, TargetNullValue=unknown}" Width="65" />
                    <DataGridTextColumn Header="Publisher (version info)" Binding="{Binding Publisher, TargetNullValue=n/a}" Width="170" />
                    <DataGridTextColumn Header="File exists" Binding="{Binding ExecutableExists, TargetNullValue=n/a}" Width="70" />
                    <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" Width="90" />
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="420" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="420" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Style="{StaticResource SectionTitle}" Text="Services" />
            <DataGrid Grid.Row="2" ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="260" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                    <DataGridTextColumn Header="Start type" Binding="{Binding StartType}" Width="80" />
                    <DataGridTextColumn Header="Delayed" Binding="{Binding DelayedStart}" Width="60" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                    <DataGridTextColumn Header="Account" Binding="{Binding Account, TargetNullValue=n/a}" Width="170" />
                    <DataGridTextColumn Header="Shared process" Binding="{Binding SharesProcess}" Width="90" />
                    <DataGridTextColumn Header="Image path" Binding="{Binding ImagePath, TargetNullValue=n/a}" Width="420" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
