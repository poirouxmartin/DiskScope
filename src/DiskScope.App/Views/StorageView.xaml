<UserControl x:Class="DiskScope.App.Views.StorageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskScope.App.Localization"
        xmlns:controls="clr-namespace:DiskScope.App.Controls">
    <UserControl.Resources>
        <ContextMenu x:Key="FileRowMenu" x:Shared="False">
            <MenuItem Header="{loc:Loc Storage_CopyPath}"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Loc Storage_OpenInExplorer}"
                      Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
    <!-- Start screen: one card per drive, shown until a first scan starts. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Panel.ZIndex="1" Background="{DynamicResource WindowBrush}"
                  Visibility="{Binding ShowStartScreen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="14,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{loc:Loc Storage_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{loc:Loc Storage_StartPrompt}" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Bottom" Margin="12,0,0,4" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{StaticResource GlyphStorage}"
                                           FontSize="32" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Tag="{StaticResource GlyphSearch}"
                                        Content="{loc:Loc Storage_Analyze}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.AnalyzeDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat=Analyze {0}}" />
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UsedText}" Margin="10,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <controls:SegmentGaugeControl Height="10" Margin="0,8,0,6" Percent="{Binding UsedPercent}"
                                                                  Track="{DynamicResource TrackBrush}"
                                                                  Visibility="{Binding IsSizeKnown, Converter={StaticResource BoolToVisibility}}">
                                        <controls:SegmentGaugeControl.Style>
                                            <Style TargetType="controls:SegmentGaugeControl">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SegmentGaugeControl.Style>
                                    </controls:SegmentGaugeControl>
                                    <TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource IconButton}" Tag="{StaticResource GlyphFolder}" Content="{loc:Loc Storage_ChooseFolderEllipsis}"
                    Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Left" Margin="6,10,0,0" />
        </StackPanel>
    </ScrollViewer>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Tag="{StaticResource GlyphSearch}" Content="{loc:Loc Storage_Analyze}"
                        Command="{Binding ScanCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource GlyphCancel}" Content="{loc:Loc Storage_Cancel}"
                        Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource GlyphExport}" Content="{loc:Loc Storage_ExportCsv}"
                        Command="{Binding ExportCsvCommand}" />
                <RadioButton Content="{loc:Loc Storage_Logical}" GroupName="size"
                             IsChecked="{Binding IsLogical, Mode=TwoWay}"
                             ToolTip="{loc:Loc Storage_LogicalTooltip}"
                             VerticalAlignment="Center" Margin="12,0,8,0" />
                <RadioButton Content="{loc:Loc Storage_Allocated}" GroupName="size"
                             IsChecked="{Binding IsAllocated, Mode=TwoWay}"
                             ToolTip="{loc:Loc Storage_AllocatedTooltip}"
                             VerticalAlignment="Center" Margin="8,0" />
            </StackPanel>
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="{StaticResource GlyphFolder}"
                    ToolTip="{loc:Loc Storage_ChooseFolder}" Command="{Binding ChooseFolderCommand}" Margin="0,0,6,0" Padding="8,5" />
            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4"
                     IsIndeterminate="{Binding IsScanning}" />

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="6,2" />

        <!-- Main: tree on the left, file lists (largest files, search, extensions) on the right -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TreeView Grid.Row="0"
                          ItemsSource="{Binding RootNodes}"
                          Grid.IsSharedSizeScope="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          SelectedItemChanged="OnTreeSelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <Grid.ColumnDefinitions>
                                    <!-- Fixed width: a star column sizes to content inside a TreeViewItem and misaligns the numbers. -->
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Pct" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="{loc:Loc Storage_Col_Size}" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="{loc:Loc Storage_Col_Files}" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                                </Grid.ColumnDefinitions>

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc Storage_CopyPath}"
                                                  Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{loc:Loc Storage_OpenInExplorer}"
                                                  Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                           MinWidth="60" Margin="8,0,0,0" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding TotalSizeText}"
                                           MinWidth="90" Margin="8,0,0,0" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding FileCount, StringFormat=N0}"
                                           MinWidth="80" Margin="8,0,0,0" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                           Foreground="DarkOrange" Margin="8,0,0,0" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <controls:TreemapControl Index="{Binding Index}"
                                             RootId="{Binding TreemapRootId, Mode=TwoWay}"
                                             SizeKind="{Binding SizeKind}"
                                             SelectedId="{Binding SelectedNodeId, Mode=TwoWay}" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <TabControl Grid.Column="2">
                <TabItem Header="{loc:Loc Storage_TabLargestFiles}">
                    <ListView ItemsSource="{Binding LargestFiles}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                <Setter Property="ContextMenu" Value="{StaticResource FileRowMenu}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Loc Storage_Col_Size}" Width="90"
                                                DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="{loc:Loc Storage_Col_File}" Width="500">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding Folder}" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="{loc:Loc Storage_TabSearch}" DataContext="{Binding Search}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Storage_NameContains}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Storage_TabExtensions}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc Storage_ExtensionsHint}"
                                     Margin="4,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Storage_MinSize}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding MinSizeMbText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Storage_MaxSize}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding MaxSizeMbText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Storage_ModifiedFrom}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <DatePicker Grid.Row="4" Grid.Column="1"
                                        SelectedDate="{Binding ModifiedFrom}"
                                        Margin="4,2" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Storage_ModifiedTo}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <DatePicker Grid.Row="5" Grid.Column="1"
                                        SelectedDate="{Binding ModifiedTo}"
                                        Margin="4,2" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc Storage_Type}"
                                       VerticalAlignment="Center" Margin="4,2" />
                            <ComboBox Grid.Row="6" Grid.Column="1"
                                      ItemsSource="{Binding KindOptions}"
                                      SelectedItem="{Binding Kind}"
                                      Margin="4,2" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding InputError}"
                                   Foreground="Firebrick" Margin="4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultText}" Margin="4" />

                        <ListView ItemsSource="{Binding Results}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                    <Setter Property="ContextMenu" Value="{StaticResource FileRowMenu}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:Loc Storage_Col_Size}" Width="90"
                                                    DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="{loc:Loc Storage_Col_Path}" Width="500"
                                                    DisplayMemberBinding="{Binding Path}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{loc:Loc Storage_TabExtensions}">
                    <ListView ItemsSource="{Binding Extensions}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Loc Storage_Col_Extension}" Width="120"
                                                DisplayMemberBinding="{Binding DisplayName}" />
                                <GridViewColumn Header="{loc:Loc Storage_Col_Files}" Width="80"
                                                DisplayMemberBinding="{Binding FileCount, StringFormat=N0}" />
                                <GridViewColumn Header="{loc:Loc Storage_Col_Size}" Width="90"
                                                DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="{loc:Loc Storage_Col_Share}" Width="70"
                                                DisplayMemberBinding="{Binding PercentText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Summary and errors -->
        <Expander Grid.Row="4" Header="{loc:Loc Storage_SummaryAndErrors}">
            <ScrollViewer MaxHeight="200">
                <TextBlock Text="{Binding Summary}" FontFamily="Consolas" />
            </ScrollViewer>
        </Expander>
    </Grid>
    </Grid>
</UserControl>
