<UserControl x:Class="DiskScope.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskScope.App.Localization"
             xmlns:controls="clr-namespace:DiskScope.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6">
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Alerts_History}" />
            <StackPanel Orientation="Horizontal" Margin="6,2">
                <TextBlock Text="{loc:Loc Alerts_Metric}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding HistoryMetrics}" SelectedItem="{Binding HistoryMetric}" Width="340">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <Binding>
                                        <Binding.Converter>
                                            <loc:MetricNameConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Loc Alerts_Range}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox ItemsSource="{Binding HistoryRanges}" SelectedItem="{Binding HistoryRange}" Width="110" />
                <Button Style="{StaticResource MenuButton}" Content="{loc:Loc Alerts_Export}" Margin="12,0,0,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Alerts_ExportHistoryCsv}" Command="{Binding ExportHistoryCsvCommand}" />
                            <MenuItem Header="{loc:Loc Alerts_ExportJson}" Command="{Binding ExportJsonCommand}" />
                            <MenuItem Header="{loc:Loc Alerts_ExportHtml}" Command="{Binding ExportHtmlCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding ExportStatus}" Margin="8,2" Foreground="{DynamicResource MutedTextBrush}"
                       ToolTip="{loc:Loc Alerts_ExportTooltip}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:SparklineControl Height="160" Points="{Binding HistoryPoints}" End="{Binding Now}" Window="{Binding HistoryRange}" />
                    <TextBlock Text="{Binding HistorySummary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"
                               Text="{loc:Loc Alerts_HistoryNote}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Alerts_Title}" />
            <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding HasItems, ElementName=AlertsGrid}"
                            Content="{loc:Loc Alerts_EmptyAlerts}" />
            <DataGrid x:Name="AlertsGrid" Style="{StaticResource HideWhenEmpty}" ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="6" MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Started}" Binding="{Binding Started}" Width="140" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Ended}" Binding="{Binding Ended}" Width="70" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Level}" Binding="{Binding Level}" Width="60" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Alert}" Binding="{Binding Title}" Width="180" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Explanation}" Binding="{Binding Explanation}" Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Evidence}" Binding="{Binding Evidence}" Width="260" />
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{loc:Loc Alerts_Acknowledge}" Command="{Binding AcknowledgeCommand}" Padding="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Alerts_HypothesesTitle}" />
            <ContentControl Style="{StaticResource EmptyState}" Tag="{Binding HasItems, ElementName=FindingsGrid}"
                            Content="{loc:Loc Alerts_EmptyFindings}" />
            <DataGrid x:Name="FindingsGrid" Style="{StaticResource HideWhenEmpty}" ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="6" MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Period}" Binding="{Binding Period}" Width="130" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Level}" Binding="{Binding Level}" Width="170" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Hypothesis}" Binding="{Binding Title}" Width="240" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Observed}" Binding="{Binding Explanation}" Width="300" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_ToCheck}" Binding="{Binding Checks}" Width="300" />
                    <DataGridTextColumn Header="{loc:Loc Alerts_Col_Limits}" Binding="{Binding Limits}" Width="300" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Alerts_Rules}" />
            <!-- One compact line per rule; "Why?" unfolds the rationale and the known false positives. -->
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource CriticalBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                     FontFamily="{DynamicResource NumberFont}" ToolTip="{loc:Loc Alerts_Threshold}" />
                                            <TextBlock Text="{Binding ThresholdUnit}" MinWidth="28" Margin="6,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <Button Content="{loc:Loc Alerts_Apply}" Command="{Binding ApplyCommand}" Padding="10,3" />
                                            <ToggleButton x:Name="Why" Content="{loc:Loc Alerts_Why}" Cursor="Hand" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{DynamicResource AccentTextBrush}"
                                                                   Padding="6,2" Background="Transparent" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="T" Property="Text" Value="{loc:Loc Alerts_Hide}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </StackPanel>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Condition}" Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Condition}" />
                                    </DockPanel>
                                    <StackPanel Margin="22,6,0,0" Visibility="{Binding IsChecked, ElementName=Why, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="{loc:Loc Alerts_KnownFalsePositives}" /><Run Text="{Binding KnownFalsePositives, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
