<UserControl x:Class="DiskScope.App.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskScope.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6">
            <TextBlock Text="{Binding GpuStatus}" Margin="8,4" Foreground="{DynamicResource MutedTextBrush}" />
            <ItemsControl ItemsSource="{Binding GpuAdapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                            <TextBlock Text="{Binding Identity}" Margin="8,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Card}">
                                    <ContentPresenter Content="{Binding UsageTile}" ContentTemplate="{StaticResource TileTemplate}" />
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <ContentPresenter Content="{Binding DedicatedTile}" ContentTemplate="{StaticResource TileTemplate}" />
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <ContentPresenter Content="{Binding SharedTile}" ContentTemplate="{StaticResource TileTemplate}" />
                                </Border>
                            </UniformGrid>
                            <DataGrid ItemsSource="{Binding EngineRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" Margin="6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Gpu_Col_Engine}" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="{loc:Loc Gpu_Col_Usage}" Binding="{Binding Value}" Width="90" />
                                    <DataGridTextColumn Header="{loc:Loc Gpu_Col_Definition}" Binding="{Binding Definition}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Gpu_ProcessesTitle}" />
            <DataGrid ItemsSource="{Binding GpuProcesses}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Margin="6" MaxHeight="320">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Gpu_Col_Process}" Binding="{Binding Name}" Width="260" />
                    <DataGridTextColumn Header="{loc:Loc Gpu_Col_Pid}" Binding="{Binding Pid}" Width="70" />
                    <DataGridTextColumn Header="{loc:Loc Gpu_Col_Gpu}" Binding="{Binding PercentText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Margin="8,4" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="{loc:Loc Gpu_Footnote}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
