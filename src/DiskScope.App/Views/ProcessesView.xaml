<UserControl x:Class="DiskScope.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskScope.App.Localization">
    <TabControl Margin="6">
        <!-- Processes grouped by image name, with a short history and what closing each one would return. -->
        <TabItem Header="{loc:Loc Consumers_Tab}">
            <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Consumers_ReadOnly}"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ConsumerSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                <DataGrid ItemsSource="{Binding Consumers}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Consumers_Col_Application}" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="{loc:Loc Consumers_Col_Kind}" Binding="{Binding KindText}" SortMemberPath="Kind" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Consumers_Col_Processes}" Binding="{Binding ProcessCountText}" SortMemberPath="ProcessCount" Width="75" />
                        <DataGridTextColumn Header="{loc:Loc Consumers_Col_CpuNow}" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="65" />
                        <DataGridTextColumn Binding="{Binding CpuAverageText}" SortMemberPath="CpuAverage" Width="65">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Loc Consumers_Col_CpuAvg}" ToolTip="{loc:Loc Consumers_Col_CpuAvgTip}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CpuMaxText}" SortMemberPath="CpuMax" Width="65">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Loc Consumers_Col_CpuMax}" ToolTip="{loc:Loc Consumers_Col_CpuMaxTip}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_PrivateBytes}" Binding="{Binding PrivateBytesText}" SortMemberPath="PrivateBytes" Width="90" />
                        <DataGridTextColumn Binding="{Binding PrivateWorkingSetText}" SortMemberPath="PrivateWorkingSet" Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Loc Consumers_Col_PrivateRam}" ToolTip="{loc:Loc Consumers_Col_PrivateRamTip}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding PrivateTrendText}" Width="75">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Loc Consumers_Col_Trend}" ToolTip="{loc:Loc Consumers_Col_TrendTip}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{loc:Loc Consumers_Col_IfClosed}" Binding="{Binding Advice}" Width="*" MinWidth="300">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Advice}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="{loc:Loc Processes_TabAll}">
            <DockPanel Margin="0,4,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{loc:Loc Processes_Filter}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" VerticalContentAlignment="Center" />
                    <CheckBox Content="{loc:Loc Processes_ShowTree}" IsChecked="{Binding ShowTree}" VerticalAlignment="Center" Margin="14,0,0,0"
                              ToolTip="{loc:Loc Processes_ShowTreeTooltip}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource GlyphExport}" Content="{loc:Loc Processes_ExportCsv}"
                            Command="{Binding ExportCommand}" Margin="12,0,0,0" />
                    <TextBlock Text="{loc:Loc Processes_ReadOnly}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                <!-- Largest memory first (or tree order) until a column header is clicked; then a flat sort by that column. -->
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc Processes_Col_Name}" Width="230" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Pid}" Binding="{Binding Pid}" Width="60" />
                        <!-- Private bytes with a bar relative to the largest process in the list (none when unknown). -->
                        <DataGridTemplateColumn Header="{loc:Loc Processes_Col_PrivateBytes}" SortMemberPath="PrivateBytes" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PrivateBytesText}" FontFamily="{DynamicResource NumberFont}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Height="6" Maximum="100" Margin="4,0,0,0" VerticalAlignment="Center"
                                                     Value="{Binding MemoryShare, Mode=OneWay, TargetNullValue=0}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MemoryShare}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Cpu}" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="125" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_WorkingSet}" Binding="{Binding WorkingSetText}" SortMemberPath="WorkingSet" Width="120" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_PrivateWs}" Binding="{Binding PrivateWorkingSetText}" SortMemberPath="PrivateWorkingSet" Width="90" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Threads}" Binding="{Binding Threads}" Width="65" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Handles}" Binding="{Binding HandlesText}" SortMemberPath="Handles" Width="70" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_IoRead}" Binding="{Binding IoReadText}" SortMemberPath="IoRead" Width="85" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_IoWrite}" Binding="{Binding IoWriteText}" SortMemberPath="IoWrite" Width="85" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Started}" Binding="{Binding Started}" Width="140" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Growth}" Binding="{Binding Growth}" Width="260" />
                        <DataGridTextColumn Header="{loc:Loc Processes_Col_Path}" Binding="{Binding Path}" Width="500" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
