<UserControl x:Class="DiskScope.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="6">
        <!-- Processes grouped by image name, with a short history and what closing each one would return. -->
        <TabItem Header="By application">
            <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Read-only: DiskScope never ends a process. The estimate is what an application returns when you close it yourself."
                           Foreground="#6B7580" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ConsumerSummary}" TextWrapping="Wrap" Foreground="#4A5560" Margin="0,4,0,0" />
                <DataGrid ItemsSource="{Binding Consumers}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" SortMemberPath="Kind" Width="100" />
                        <DataGridTextColumn Header="Processes" Binding="{Binding ProcessCountText}" SortMemberPath="ProcessCount" Width="75" />
                        <DataGridTextColumn Header="CPU now" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="65" />
                        <DataGridTextColumn Binding="{Binding CpuAverageText}" SortMemberPath="CpuAverage" Width="65">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="CPU avg" ToolTip="Average CPU % of the machine over the last 5 minutes" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CpuMaxText}" SortMemberPath="CpuMax" Width="65">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="CPU max" ToolTip="Highest CPU % of the machine over the last 5 minutes" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Private bytes" Binding="{Binding PrivateBytesText}" SortMemberPath="PrivateBytes" Width="90" />
                        <DataGridTextColumn Binding="{Binding PrivateWorkingSetText}" SortMemberPath="PrivateWorkingSet" Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Private RAM" ToolTip="Private working set: physical memory used by this application alone" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding PrivateTrendText}" Width="75">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="5 min trend" ToolTip="Change of private bytes over the last 5 minutes (least-squares line)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="If closed" Binding="{Binding Advice}" Width="*" MinWidth="300">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Advice}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="All processes">
            <DockPanel Margin="0,4,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Filter (name, PID or path):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" VerticalContentAlignment="Center" />
                    <Button Content="Export CSV" Command="{Binding ExportCommand}" Padding="10,2" Margin="8,0,0,0" />
                    <TextBlock Text="Read-only: no process is stopped or modified." Foreground="#6B7580" VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#4A5560" Margin="0,4,0,0" />
                <!-- Tree order (indented) until a column header is clicked; then a flat sort by that column. -->
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="230" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                        <DataGridTextColumn Header="CPU (% machine)" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="110" />
                        <DataGridTextColumn Header="Private bytes" Binding="{Binding PrivateBytesText}" SortMemberPath="PrivateBytes" Width="100" />
                        <DataGridTextColumn Header="Working set" Binding="{Binding WorkingSetText}" SortMemberPath="WorkingSet" Width="100" />
                        <DataGridTextColumn Header="Private WS" Binding="{Binding PrivateWorkingSetText}" SortMemberPath="PrivateWorkingSet" Width="90" />
                        <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="65" />
                        <DataGridTextColumn Header="Handles" Binding="{Binding HandlesText}" SortMemberPath="Handles" Width="70" />
                        <DataGridTextColumn Header="I/O read" Binding="{Binding IoReadText}" SortMemberPath="IoRead" Width="85" />
                        <DataGridTextColumn Header="I/O write" Binding="{Binding IoWriteText}" SortMemberPath="IoWrite" Width="85" />
                        <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="140" />
                        <DataGridTextColumn Header="Memory growth" Binding="{Binding Growth}" Width="260" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="500" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
