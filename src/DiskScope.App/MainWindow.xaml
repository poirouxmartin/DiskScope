<Window x:Class="DiskScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskScope"
        Width="1100" Height="700">
    <Window.Resources>
        <ContextMenu x:Key="FileRowMenu" x:Shared="False">
            <MenuItem Header="Copy path"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="Open in Explorer"
                      Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Scan" Command="{Binding ScanCommand}"
                        Margin="4,0" Padding="12,2" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Margin="4,0" Padding="12,2" />
                <RadioButton Content="Logical" GroupName="size"
                             IsChecked="{Binding IsLogical, Mode=TwoWay}"
                             VerticalAlignment="Center" Margin="8,0" />
                <RadioButton Content="Allocated" GroupName="size"
                             IsChecked="{Binding IsAllocated, Mode=TwoWay}"
                             VerticalAlignment="Center" Margin="8,0" />
            </StackPanel>
            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4"
                     IsIndeterminate="{Binding IsScanning}" />

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="6,2" />

        <!-- Main: tree on the left, largest files on the right -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0"
                      ItemsSource="{Binding RootNodes}"
                      Grid.IsSharedSizeScope="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                            <Grid.ColumnDefinitions>
                                <!-- Fixed width: a star column sizes to content inside a TreeViewItem and misaligns the numbers. -->
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Pct" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Files" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                            </Grid.ColumnDefinitions>

                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy path"
                                              Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Open in Explorer"
                                              Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                       MinWidth="60" Margin="8,0,0,0" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalSizeText}"
                                       MinWidth="90" Margin="8,0,0,0" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding FileCount, StringFormat=N0}"
                                       MinWidth="80" Margin="8,0,0,0" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                       Foreground="DarkOrange" Margin="8,0,0,0" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <ListView Grid.Column="2"
                      ItemsSource="{Binding LargestFiles}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource FileRowMenu}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Size" Width="90"
                                        DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Path" Width="500"
                                        DisplayMemberBinding="{Binding Path=Path}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Summary and errors -->
        <Expander Grid.Row="4" Header="Summary and errors">
            <ScrollViewer MaxHeight="200">
                <TextBlock Text="{Binding Summary}" FontFamily="Consolas" />
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>
