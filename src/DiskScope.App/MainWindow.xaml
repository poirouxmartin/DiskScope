<Window x:Class="DiskScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskScope"
        Width="900" Height="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                    Margin="4,0,0,0" Padding="12,2" />
            <Button DockPanel.Dock="Right" Content="Scan" Command="{Binding ScanCommand}"
                    Padding="12,2" />
            <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" Margin="8,0"
                     IsIndeterminate="{Binding IsScanning}" />

        <TextBlock Grid.Row="2" Margin="8,4" Text="{Binding StatusText}" />

        <ScrollViewer Grid.Row="3" Margin="8">
            <TextBlock Text="{Binding Summary}" FontFamily="Consolas" />
        </ScrollViewer>
    </Grid>
</Window>
