<Window x:Class="DiskScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiskScope.App.Views"
        Title="DiskScope"
        Width="1200" Height="780">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Monitoring.StatusText}" />
            <Separator />
            <StatusBarItem Content="{Binding Monitoring.SelfCostText}" />
        </StatusBar>
        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Dashboard">
                <views:DashboardView />
            </TabItem>
            <TabItem Header="Storage">
                <views:StorageView DataContext="{Binding Storage}" />
            </TabItem>
            <TabItem Header="CPU &amp; memory">
                <views:CpuMemoryView DataContext="{Binding Monitoring}" />
            </TabItem>
            <TabItem Header="Processes">
                <views:ProcessesView DataContext="{Binding Processes}" />
            </TabItem>
            <TabItem Header="GPU">
                <views:GpuView DataContext="{Binding Monitoring}" />
            </TabItem>
            <TabItem Header="History &amp; alerts">
                <views:HistoryView DataContext="{Binding Monitoring}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
