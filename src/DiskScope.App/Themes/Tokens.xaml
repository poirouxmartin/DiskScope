<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Design tokens. Every view uses these keys, so the visual direction is one file.
         Values below are neutral placeholders until the direction is chosen. -->
    <Color x:Key="AccentColor">#3B6EA5</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2F5A88" />

    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#E9EBEE" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
    <SolidColorBrush x:Key="TextBrush" Color="#1E242C" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5C6670" />
    <SolidColorBrush x:Key="LineBrush" Color="#D5DAE0" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#DDE2E8" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E2E6EB" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E3E7EC" />

    <SolidColorBrush x:Key="WarningBrush" Color="#C27C0E" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C23B2E" />
    <SolidColorBrush x:Key="GoodBrush" Color="#1F8A4C" />

    <CornerRadius x:Key="CardRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Segoe Fluent Icons glyphs. -->
    <sys:String x:Key="GlyphHome">&#xE80F;</sys:String>
    <sys:String x:Key="GlyphStorage">&#xEDA2;</sys:String>
    <sys:String x:Key="GlyphCpu">&#xE9D9;</sys:String>
    <sys:String x:Key="GlyphProcesses">&#xE8FD;</sys:String>
    <sys:String x:Key="GlyphGpu">&#xE7F4;</sys:String>
    <sys:String x:Key="GlyphAlerts">&#xEA8F;</sys:String>
    <sys:String x:Key="GlyphStartup">&#xE7E8;</sys:String>
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphExport">&#xEDE1;</sys:String>
    <sys:String x:Key="GlyphCancel">&#xE711;</sys:String>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphChevronDown">&#xE70D;</sys:String>
</ResourceDictionary>
