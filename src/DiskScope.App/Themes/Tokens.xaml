<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Design tokens: visual direction "Instrument" (dark, measuring-instrument look).
         Every view uses these keys, so the visual direction lives in this one file. -->
    <Color x:Key="AccentColor">#57B7E8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#08202D" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7CC8EF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3A4D" />

    <SolidColorBrush x:Key="WindowBrush" Color="#161B21" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#11151A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E252D" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#252D36" />
    <SolidColorBrush x:Key="InputBrush" Color="#141A20" />
    <SolidColorBrush x:Key="TextBrush" Color="#E4E9EE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8D98A5" />
    <SolidColorBrush x:Key="LineBrush" Color="#2C3540" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1E252D" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#191F26" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2A333D" />

    <SolidColorBrush x:Key="WarningBrush" Color="#E8A33A" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#E5534B" />
    <SolidColorBrush x:Key="GoodBrush" Color="#4CC38A" />
    <SolidColorBrush x:Key="OnStatusBrush" Color="#0E1317" />

    <CornerRadius x:Key="CardRadius">4</CornerRadius>
    <CornerRadius x:Key="ControlRadius">3</CornerRadius>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Segoe Fluent Icons glyphs. -->
    <sys:String x:Key="GlyphHome">&#xE80F;</sys:String>
    <sys:String x:Key="GlyphStorage">&#xEDA2;</sys:String>
    <sys:String x:Key="GlyphCpu">&#xE9D9;</sys:String>
    <sys:String x:Key="GlyphProcesses">&#xE8FD;</sys:String>
    <sys:String x:Key="GlyphGpu">&#xE7F4;</sys:String>
    <sys:String x:Key="GlyphAlerts">&#xEA8F;</sys:String>
    <sys:String x:Key="GlyphStartup">&#xE7E8;</sys:String>
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphExport">&#xEDE1;</sys:String>
    <sys:String x:Key="GlyphCancel">&#xE711;</sys:String>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphChevronDown">&#xE70D;</sys:String>
</ResourceDictionary>
